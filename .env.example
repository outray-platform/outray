BASE_DOMAIN=localhost.direct
TUNNEL_PORT=3547
REDIS_URL=redis://127.0.0.1:6379
WEB_API_URL=http://localhost:6767/api
INTERNAL_API_SECRET=replace-with-your-control-plane-secret
OUTRAY_DEPLOYMENT_MODE=self-hosted
UPTIME_ENABLED=false
# Optional platform integration settings; never commit actual credentials.
# DATABASE_URL=postgresql://edge:password@localhost:5432/outray?sslmode=disable
# TINYBIRD_API_HOST=https://api.tinybird.co
# TINYBIRD_TUNNEL_INGEST_TOKEN=replace-with-an-append-only-token

# Only these direct proxy peers may supply X-Forwarded-For for guest limits.
# Default: loopback. Ops can reuse STATUS_TRUSTED_PROXY_IPS for its Caddy peer.
# TUNNEL_TRUSTED_PROXY_IPS=127.0.0.1,::1
